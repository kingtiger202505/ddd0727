<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.quotation.infrastructure.persistence.mapper.QuotationMapper">

    <!-- 通用结果映射 -->
    <resultMap id="BaseResultMap" type="com.quotation.domain.quotation.model.Quotation">
        <id column="id" property="id"/>
        <result column="buyer_id" property="buyerId"/>
        <result column="seller_id" property="sellerId"/>
        <result column="product_id" property="productId"/>
        <result column="product_name" property="productName"/>
        <result column="price" property="price"/>
        <result column="quantity" property="quantity"/>
        <result column="status" property="status"/>
        <result column="version" property="version"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <!-- 通用字段列表 -->
    <sql id="Base_Column_List">
        id, buyer_id, seller_id, product_id, product_name, price, quantity, status, version, created_at, updated_at
    </sql>

</mapper>
