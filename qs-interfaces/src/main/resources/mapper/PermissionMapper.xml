<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.quotation.infrastructure.persistence.mapper.PermissionMapper">

    <resultMap id="PermissionResultMap" type="com.quotation.domain.user.model.Permission">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="permissionName" column="permission_name"/>
        <result property="type" column="type"/>
        <result property="parentId" column="parent_id"/>
        <result property="path" column="path"/>
        <result property="icon" column="icon"/>
        <result property="sort" column="sort"/>
        <result property="description" column="description"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 根据角色 ID 查询权限列表 -->
    <select id="selectByRoleId" resultMap="PermissionResultMap">
        SELECT p.* FROM permission p
        INNER JOIN role_permission rp ON p.id = rp.permission_id
        WHERE rp.role_id = #{roleId}
        ORDER BY p.sort ASC, p.id ASC
    </select>

    <!-- 根据用户 ID 查询权限列表 -->
    <select id="selectByUserId" resultMap="PermissionResultMap">
        SELECT DISTINCT p.* FROM permission p
        INNER JOIN role_permission rp ON p.id = rp.permission_id
        INNER JOIN user_role ur ON rp.role_id = ur.role_id
        WHERE ur.user_id = #{userId}
        ORDER BY p.sort ASC, p.id ASC
    </select>

    <!-- 查询子权限 -->
    <select id="selectByParentId" resultMap="PermissionResultMap">
        SELECT * FROM permission WHERE parent_id = #{parentId} ORDER BY sort ASC, id ASC
    </select>

    <!-- 根据权限编码查询 -->
    <select id="selectByPermCode" resultMap="PermissionResultMap">
        SELECT * FROM permission WHERE code = #{permCode} LIMIT 1
    </select>

</mapper>
